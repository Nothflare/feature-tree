{
  "name": "feature-tree",
  "version": "3.0.2",
  "description": "AI-driven feature management for Claude Code. Track features, link to code symbols and commits, maintain living documentation.",
  "author": {
    "name": "Feature Tree Contributors"
  },
  "license": "MIT",
  "keywords": ["mcp", "features", "documentation", "project-management"],
  "repository": "https://github.com/Nothflare/feature-tree",
  "mcpServers": {
    "feature-tree": {
      "command": "uv",
      "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "feature-tree"],
      "env": {
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
        "FT_EMBEDDING_MODEL": "${FT_EMBEDDING_MODEL}",
        "FT_EMBEDDING_ENDPOINT": "${FT_EMBEDDING_ENDPOINT}"
      }
    }
  }
}
